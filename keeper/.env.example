# Cadence Keeper Bot — Environment Configuration
#
# Copy this file to `.env` and fill in values. All keys can also be passed
# as CLI flags (run `cargo run -p keeper -- --help`).

# Soroban JSON-RPC endpoint (default: Testnet)
RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Cadence contract address (C…)
CADENCE_CONTRACT_ID=

# Keeper account secret key (S…). Not required with --dry-run.
KEEPER_SECRET_KEY=

# Comma-separated subscription IDs to poll
SUB_IDS=

# Seconds between polling rounds (default: 60)
POLL_INTERVAL_SECS=60

# Maximum retries on transient RPC errors (default: 5)
MAX_RETRIES=5

# Set to true for dry-run mode (logs actions without submitting transactions)
DRY_RUN=false
